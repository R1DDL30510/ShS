## Shared defaults for the SHS compose stack.
## Copy this file to .env and adjust as needed.

DOTNET_ENVIRONMENT=Development

WEBUI_PORT=3000
QDRANT_PORT=6333
AUTOMATIC1111_PORT=7860

DATA_DIR=../data
AUTOMATIC1111_DATA_DIR=../data/automatic1111
AUTOMATIC1111_MODELS_DIR=../models/stable-diffusion
AUTOMATIC1111_WORKSPACE=../stablediff/stable-diffusion-webui

AUTOMATIC1111_GPU_SELECTION=all
AUTOMATIC1111_GPU_COUNT=all

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MAX_GPU_MEMORY=0.8

OPENWEBUI_AUTH=false
AUTOMATIC1111_ARGS=--listen --port 7860 --api --xformers --data-dir /data --ckpt-dir /data/Models --medvram --opt-sdp-attention
