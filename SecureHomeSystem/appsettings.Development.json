{
  "Health": {
    "Port": 5081
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Docker": {
    "AutoStartProfiles": [ "worker", "diffusion" ]
  },
  "ResourceScheduler": {
    "PollIntervalSeconds": 3,
    "QueueBackoffSeconds": 10
  }
}
