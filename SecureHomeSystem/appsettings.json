{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Docker": {
    "ComposeFilePath": "docker/compose.yaml",
    "EnvironmentFile": "docker/.env",
    "ProjectName": "shs-stack",
    "AutoStartProfiles": [ "worker" ],
    "Detection": {
      "LabelSelector": {
        "open-webui": "shs.role=open-webui",
        "qdrant": "shs.role=qdrant",
        "stable-diffusion": "shs.role=stable-diffusion"
      },
      "FriendlyNames": {
        "open-webui": "HomeChatGPT",
        "qdrant": "Qdrant",
        "stable-diffusion": "Stable Diffusion"
      },
      "StartupTimeoutSeconds": 120,
      "RetryCount": 3
    }
  },
  "Services": {
    "Ollama": {
      "DisplayName": "Ollama",
      "BaseUrl": "http://host.docker.internal:11434",
      "MaxGpuMemoryFraction": 0.8,
      "HealthEndpoint": "/api/tags"
    },
    "OpenWebUi": {
      "DisplayName": "HomeChatGPT",
      "BaseUrl": "http://localhost:3003",
      "RequireAuth": false,
      "HealthEndpoint": "/api/system/info"
    },
    "StableDiffusion": {
      "DisplayName": "Stable Diffusion",
      "BaseUrl": "http://localhost:7860",
      "LaunchProfile": "diffusion",
      "SmokeTestPrompt": "Generate a 64x64 diagnostic image"
    }
  },
  "ResourceScheduler": {
    "GpuUtilisationThreshold": 0.5,
    "GpuMemoryThreshold": 0.8,
    "PollIntervalSeconds": 5,
    "QueueBackoffSeconds": 30
  }
}
